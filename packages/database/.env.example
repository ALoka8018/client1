# ==============================================================================
# SEEPAGE DOCTOR — DATABASE / PRISMA ENVIRONMENT CONFIGURATION
# (packages/database/.env)
# ==============================================================================

# PostgreSQL connection string used by Prisma CLI for migrations and studio.
# Local Postgres example:
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/plumbing?schema=public"

# Supabase direct connection or transaction pooler example:
# DATABASE_URL="postgresql://postgres.<project_ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
