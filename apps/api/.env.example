PORT=4000
DATABASE_URL="postgresql://user:password@localhost:5432/plumbing?schema=public"
CORS_ORIGIN="http://localhost:3000"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
MAIL_FROM="Seepage Doctor <no-reply@example.com>"
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"
GCS_PROJECT_ID="your-gcp-project-id"
GCS_BUCKET_NAME="your-gcs-bucket-name"
GCS_CREDENTIALS_JSON="base64-encoded-service-account-json-key"
# Optional — defaults to solutions@aiasengineering.com. Override for local/test runs
# so new-support-ticket alert emails don't land in the real support inbox.
SUPPORT_INBOX_EMAIL="your-test-inbox@example.com"
