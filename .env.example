# ==============================================================================
# SEEPAGE DOCTOR (plumbingAllSolution) — ALL-IN-ONE ENVIRONMENT CONFIGURATION
# ==============================================================================
# This template lists all environment variables across the entire monorepo.
#
# HOW TO SET UP LOCAL DEVELOPMENT:
# 1. Copy this file into each app/package, or copy the variables to their locations:
#    - For Database : copy DATABASE section to `packages/database/.env`
#    - For API      : copy API/BACKEND section to `apps/api/.env`
#    - For Web      : copy WEB/FRONTEND section to `apps/web/.env.local`
#
# NOTE: All actual `.env` and `.env.local` files are git-ignored and will NEVER
# be committed to GitHub.
# ==============================================================================


# ==============================================================================
# 1. DATABASE & ORM (packages/database/.env and apps/api/.env)
# ==============================================================================
# PostgreSQL connection string.
# For local Postgres: postgresql://<user>:<password>@localhost:5432/<db_name>?schema=public
# For Supabase: postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/plumbing?schema=public"


# ==============================================================================
# 2. BACKEND API (apps/api/.env)
# ==============================================================================
# Server port (defaults to 4000 for local development)
PORT=4000

# Node environment: "development" or "production"
NODE_ENV=development

# Allowed origins for CORS (comma-separated for multiple origins)
CORS_ORIGIN="http://localhost:3000"

# --- Supabase Authentication (Backend Admin) ---
# Supabase project URL (Project Settings -> API -> Project URL)
SUPABASE_URL="https://abcdefghijklm.supabase.co"

# Supabase SERVICE ROLE key (Project Settings -> API -> Project API Keys -> service_role secret)
# CAUTION: Never expose this key in the frontend! It bypasses Row-Level Security.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_supabase_service_role_key_value_here"

# --- Razorpay Payments ---
# Razorpay Test/Live Key ID (from Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID="rzp_test_1234567890ABCD"

# Razorpay Test/Live Key Secret
RAZORPAY_KEY_SECRET="dummy_razorpay_secret_key_123456"

# Razorpay Webhook Secret (configured in Razorpay Dashboard -> Webhooks)
RAZORPAY_WEBHOOK_SECRET="dummy_razorpay_webhook_secret_123456"

# --- Email / SMTP (Nodemailer) ---
# Used for sending booking confirmations, status notifications, and support alerts.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="notifications@example.com"
SMTP_PASS="your_app_specific_password_here"
MAIL_FROM="Seepage Doctor <no-reply@seepagedoctor.com>"

# Internal team inbox for receiving customer support tickets & technician applications
SUPPORT_INBOX_EMAIL="support@seepagedoctor.com"

# --- Google Cloud Storage (Optional for local dev) ---
# If omitted or invalid, the API automatically falls back to in-memory storage (InMemoryStorage).
GCS_PROJECT_ID="seepage-doctor-gcp-project"
GCS_BUCKET_NAME="seepage-doctor-assets-bucket"
# Base64-encoded JSON key of a GCP Service Account with Storage Object Admin permissions
GCS_CREDENTIALS_JSON="eyJuYW1lIjoiZHVtbXktc2VydmljZS1hY2NvdW50In0="

# --- Admin Seeding Script (apps/api/src/scripts/seedAdmin.ts) ---
# Used when running: pnpm --filter api seed:admin
ADMIN_EMAIL="admin@seepagedoctor.com"
ADMIN_PASSWORD="Admin@Password123!"
ADMIN_NAME="Super Admin"
ADMIN_ROLE="SUPER_ADMIN"


# ==============================================================================
# 3. FRONTEND WEB APP (apps/web/.env.local)
# ==============================================================================
# Backend API base URL that the browser and Next.js SSR call
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Public Supabase project URL (must match the backend SUPABASE_URL)
NEXT_PUBLIC_SUPABASE_URL="https://abcdefghijklm.supabase.co"

# Public Supabase Anon/Publishable API Key (safe to expose in client-side JS)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_supabase_anon_public_key_value_here"

# Razorpay Key ID for opening the Checkout modal in the browser
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_1234567890ABCD"

